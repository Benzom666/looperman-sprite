{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sprite",
  "version": "../package.json",
  "identifier": "com.benzom666.sprite",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1337",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Sprite",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "connect-src": "'self' ipc: blob: http://ipc.localhost http://tauri.localhost https://*.splice.com/** https://spliceproduction.s3.*.amazonaws.com/** https://*.amazonaws.com/spliceblob.splice.com/** https://splice-res.cloudinary.com/** https://freesound.org/** https://cdn.freesound.org/** https://www.looperman.com/**"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
